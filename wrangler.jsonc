/**
 * Imvara Project Run
 *
 * Cloudflare Worker + Workflow configuration.
 *
 * Platform role:
 * Durable execution of governed Imvara Project Runs.
 *
 * Genericity rule:
 * No client-, brand-, Vertical-, or Job-specific logic belongs here.
 */

{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "imvara-project-run",
	"main": "worker/index.ts",
	"compatibility_date": "2025-10-08",

	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},

	"observability": {
		"enabled": true
	},

	/**
	 * Cloudflare Workflow
	 *
	 * A Project Run is the durable execution envelope for an Imvara engagement.
	 * Runtime data determines engagement, Vertical/version, evidence, Jobs,
	 * capabilities, governance state, and downstream actions.
	 */
	"workflows": [
		{
			"name": "imvara-project-run",
			"binding": "PROJECT_RUN_WORKFLOW",
			"class_name": "ProjectRunWorkflow"
		}
	],

	/**
	 * Durable Object
	 *
	 * Retained from the Cloudflare starter for real-time Workflow state.
	 * We are deliberately not renaming this class yet because doing so would
	 * introduce an unnecessary Durable Object migration during Workflow setup.
	 */
	"durable_objects": {
		"bindings": [
			{
				"name": "WORKFLOW_STATUS",
				"class_name": "WorkflowStatusDO"
			}
		]
	},

	/**
	 * Existing Durable Object migration.
	 *
	 * Do not alter this migration tag after deployment.
	 */
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["WorkflowStatusDO"]
		}
	],

	"upload_source_maps": true
}
